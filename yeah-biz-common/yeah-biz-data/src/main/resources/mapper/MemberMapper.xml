<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeshimin.yeahboot.data.mapper.MemberMapper">

    <!-- 锁定会员，避免并发下单加入同一活动的多个团。 -->
    <select id="selectByIdForUpdate" resultType="com.yeshimin.yeahboot.data.domain.entity.MemberEntity">
        SELECT *
        FROM s_member
        WHERE id = #{id}
          AND deleted = 0
        FOR UPDATE
    </select>
</mapper>
