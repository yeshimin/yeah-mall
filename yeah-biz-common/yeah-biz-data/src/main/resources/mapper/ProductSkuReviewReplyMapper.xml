<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeshimin.yeahboot.data.mapper.ProductSkuReviewReplyMapper">

    <!-- 在已锁定评价主记录的事务中读取最新回复 -->
    <select id="findLatestByReviewIdForUpdate" resultType="com.yeshimin.yeahboot.data.domain.entity.ProductSkuReviewReplyEntity">
        select *
        from s_product_sku_review_reply
        where review_id = #{reviewId}
        and deleted = 0
        order by create_time desc, id desc
        limit 1
        for update
    </select>
</mapper>
