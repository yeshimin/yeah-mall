<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeshimin.yeahboot.data.mapper.GroupBuyActivityMapper">

    <!-- 锁定活动以串行化开团和报名操作。 -->
    <select id="selectByIdForUpdate" resultType="com.yeshimin.yeahboot.data.domain.entity.GroupBuyActivityEntity">
        SELECT *
        FROM s_group_buy_activity
        WHERE id = #{id}
          AND deleted = 0
        FOR UPDATE
    </select>
</mapper>
